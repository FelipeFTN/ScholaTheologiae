# Git attributes file for Schola Theologiae
# This file helps Git and GitHub properly identify and handle different file types

# Exclude HTML files in public directory from language statistics
# These are typically static files that shouldn't affect language detection
public/*.html linguist-vendored
public/**/*.html linguist-vendored

# Exclude compiled/generated assets from language detection
app/assets/builds/* linguist-generated
public/assets/* linguist-generated

# Mark vendored dependencies
app/javascript/vendor/* linguist-vendored
vendor/* linguist-vendored

# Ensure proper line endings for different file types
*.rb text eol=lf
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Dockerfile specific
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Configuration files
*.conf text eol=lf
*.config text eol=lf
.env* text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files (should not be modified)
*.tar.gz binary
*.zip binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.sqlite3 binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Logs
*.log text

# Archives containing theological texts
books/*.tar.gz binary linguist-vendored
*.tar.gz binary
