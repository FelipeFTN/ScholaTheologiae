# Git attributes file for Schola Theologiae
# This file helps Git and GitHub properly identify and handle different file types

# Ensure proper line endings for different file types
*.rb text eol=lf
*.go text eol=lf
*.js text eol=lf
*.css -linguist-detectable
*.html -linguist-detectable
*.erb text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Dockerfile specific
Dockerfile text eol=lf
*.dockerfile text eol=lf
Dockerfile.* text eol=lf

# Configuration files
*.conf text eol=lf
*.config text eol=lf
.env* text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files (should not be modified)
*.tar.gz binary
*.zip binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.sqlite3 binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archives containing theological texts
books/*.tar.gz binary linguist-generated
*.tar.gz binary
