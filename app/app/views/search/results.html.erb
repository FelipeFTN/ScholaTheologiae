<%# Search results view - will be used later when implementing API integration %>
<% content_for :title, "Resultados da Busca - Schola Theologiae" %>

<div class="page">
  <div class="content">
    <h1>Resultados da Busca</h1>
    <p id="subtitle">resultados para "<%= @query %>"</p>
    <hr>
    
    <% if @query.present? %>
      <p>Buscando por: <strong><%= @query %></strong></p>
      <p><em>Em breve os resultados da API serão exibidos aqui.</em></p>
    <% else %>
      <p>Nenhuma busca especificada.</p>
    <% end %>
  </div>
</div>
