<% content_for :title, "Didaqué - Schola Theologiae" %>
<% content_for :body_class, "book-page" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Didaqué</h1>
    <span class="book-subtitle">Instrução dos doze apóstolos</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/didaque" %>" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>
      <div class="book-header-info">
        <h2>Capítulo</h2>
        <span class="book-parts-label">Capitulum</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= part_name("didaque", @part) %></span>
        <span class="book-chapter-number">
          Cap.<%= @chapter %><% if @chapter_progress %> &middot; <%= @chapter_progress %><% end %>
        </span>
      </div>
    </div>
    <div class="book-chapter-content">
      <%= @content %>

      <%= render "components/chapter_nav",
                 previous_path: @previous_chapter && "/books/didaque/#{@part}/#{@previous_chapter}",
                 next_path: @next_chapter && "/books/didaque/#{@part}/#{@next_chapter}" %>
    </div>
  </section>
  <aside class="book-sidebar"></aside>
</div>
