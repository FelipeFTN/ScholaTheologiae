<% content_for :title, "Didaqué - Schola Theologiae" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <%= render "components/book_head", title: "Didaqué", subtitle: "Instrução dos Doze Apóstolos" %>

    <hr class="book-divider">

    <%= render "components/book_info",
               cover: "didaque_cover.webp",
               alt: "Capa da Didaqué",
               description: %(A Didaqué, também conhecida como "O Ensino dos Doze Apóstolos", é um antigo manual cristão, datado entre 60 e 90 d.C, que oferece orientações práticas sobre a vida cristã, incluindo ensinamentos sobre moralidade, liturgia e disciplina eclesiástica.) %>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Livros</h2>
        <span class="book-parts-label">Libri</span>
      </div>
      <hr class="book-divider">

      <% if @parts.nil? %>
        <%= render "components/content_state",
                   icon: "nf-md-cloud_off",
                   title: "Conteúdo indisponível",
                   message: "Não conseguimos carregar os capítulos da Didaqué agora. Tente novamente em instantes." %>
      <% else %>
        <% @parts.each_with_index do |part, index| %>
          <%# The first section is the introduction, the others are the "books". %>
          <% label = index.zero? ? humanize_slug(part) : "Livro #{to_roman(index)} - #{humanize_slug(part)}" %>
          <%= render "components/chapter_section",
                     title: label,
                     part: part,
                     chapters: @chapters[part],
                     book_path: "/books/didaque" %>
        <% end %>
      <% end %>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
