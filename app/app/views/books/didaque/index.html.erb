<!-- Modernized and mobile-friendly Didaqué index page -->
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <div class="book-header">
      <div class="book-back-button">
        <a href="/books/" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>

      <div class="book-title-container">
        <h1 class="book-title">Didaqué</h1>
        <span class="book-subtitle">Instrução dos Doze Apóstolos</span>
      </div>

      <div style="width: 10px;"></div>
    </div>

    <hr class="book-divider">

    <div class="book-info">
      <%= image_tag("didaque_cover.png", class: "book-cover", skip_pipeline: true) %>
      <p class="book-description">
        A Didaqué, também conhecida como "O Ensino dos Doze Apóstolos", é um antigo manual cristão, datado entre 60 e 90 d.C, que oferece orientações práticas sobre a vida cristã, incluindo ensinamentos sobre moralidade, liturgia e disciplina eclesiástica.
      </p>
    </div>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Livros</h2>
        <span class="book-parts-label">Libri</span>
      </div>
      <hr class="book-divider">
      
      <% @didaque_parts.each_with_index do |part, index| %>
        <div class="book-section">
          <h3 class="book-title">
            <% is_introduction = index == 0 %>
            <% if is_introduction %>
              <%= part.gsub('_', ' ').titleize %>
            <% else %>
              Livro <%= (index).to_roman %> - <%= part.gsub('_', ' ').titleize %>
            <% end %>
          </h3>
          
          <ul class="chapters-list">
            <% chapters = @didaque_books[part] || [] %>
            <% chapters.each do |chapter| %>
              <% chapter_num = chapter.split(':').first %>
              <% chapter_title = chapter.split(':').last.strip %>
              <li>
                <a class="chapter-link" href="<%= "/books/didaque/#{part}/#{chapter_num}" %>">
                  <span class="chapter-number"><%= chapter_num %></span>
                  <span class="chapter-title"><%= chapter_title %></span>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
