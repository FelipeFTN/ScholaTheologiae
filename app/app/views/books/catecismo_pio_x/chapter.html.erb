<!-- Modernized and mobile-friendly Catecismo Pio X chapter page -->
<% content_for :body_class, 'book-page' %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Catecismo Maior</h1>
    <span class="book-subtitle">São Pio X</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/catecismo-pio-x/" %>" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>
      <div class="book-header-info">
        <h2>Capítulo</h2>
        <span class="book-parts-label">Capitulum</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= @part.gsub("_", " ").titleize %></span>
        <span class="book-chapter-number">Cap.<%= @chapter %> <a href="<%=Integer(@chapter)+1%>">&rarr;</a></span>
      </div>
    </div>
    <div class="book-chapter-content">
      <%= @content %>
      
      <div class="book-next-chapter">
        <a href="<%= "/books/catecismo-pio-x/#{@part}/#{Integer(@chapter)+1}" %>">
          Próximo Capítulo &rarr;
        </a>
      </div>
    </div>
  </section>
  <aside class="book-sidebar"></aside>
</div>
