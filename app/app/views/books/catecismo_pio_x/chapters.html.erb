<!-- Modernized and mobile-friendly Catecismo Pio X chapters list page -->
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Catecismo Maior</h1>
    <span class="book-subtitle">São Pio X</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/catecismo-pio-x" %>" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>
      <div class="book-header-info">
        <h2>Capítulos</h2>
        <span class="book-parts-label">Capitula</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= @part.gsub("_", " ").titleize %></span>
      </div>
    </div>
    <ul class="chapters-list">
      <% @catecismo_chapters.each do |chapter| %>
        <% chapter_num = chapter.split(':').first %>
        <% chapter_title = chapter.split('- ').last.strip %>
        <li>
          <a class="chapter-link" href="<%= "/books/catecismo-pio-x/#{@part}/#{chapter_num}" %>">
            <span class="chapter-number"><%= chapter_num.to_i.to_roman %></span>
            <span class="chapter-title"><%= chapter_title %></span>
          </a>
        </li>
      <% end %>
    </ul>
  </section>
  <aside class="book-sidebar"></aside>
</div>
