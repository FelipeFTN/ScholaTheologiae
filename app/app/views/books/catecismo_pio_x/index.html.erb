<% content_for :title, "Catecismo Maior de São Pio X - Schola Theologiae" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <%= render "components/book_head", title: "Catecismo Maior", subtitle: "São Pio X" %>

    <hr class="book-divider">

    <%= render "components/book_info",
               cover: "catecismo_sao_pio_x.webp",
               alt: "Capa do Catecismo Maior de São Pio X",
               description: "O Catecismo Maior de São Pio X é uma obra fundamental da doutrina católica, promulgada pelo Papa São Pio X para a instrução dos fiéis na fé cristã." %>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Partes</h2>
        <span class="book-parts-label">Pars</span>
      </div>
      <hr class="book-divider">

      <% if @parts.nil? %>
        <%= render "components/content_state",
                   icon: "nf-md-cloud_off",
                   title: "Conteúdo indisponível",
                   message: "Não conseguimos carregar as partes do catecismo agora. Tente novamente em instantes." %>
      <% else %>
        <% @parts.each_with_index do |part, index| %>
          <%= render "components/chapter_section",
                     title: "Parte #{to_roman(index + 1)} - #{humanize_slug(part)}",
                     part: part,
                     chapters: @chapters[part],
                     book_path: "/books/catecismo-pio-x" %>
        <% end %>
      <% end %>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
