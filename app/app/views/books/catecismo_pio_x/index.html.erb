<!-- Modernized and mobile-friendly Catecismo Pio X index page -->
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <div class="book-header">
      <div class="book-back-button">
        <a href="/books/" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>

      <div class="book-title-container">
        <h1 class="book-title">Catecismo Maior</h1>
        <span class="book-subtitle">São Pio X</span>
      </div>

      <div style="width: 10px;"></div>
    </div>

    <hr class="book-divider">

    <div class="book-info">
      <%= image_tag("catecismo_sao_pio_x.jpg", class: "book-cover", skip_pipeline: true) %>
      <p class="book-description">
        O Catecismo Maior de São Pio X é uma obra fundamental da doutrina católica, promulgada pelo Papa São Pio X para a instrução dos fiéis na fé cristã.
      </p>
    </div>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Partes</h2>
        <span class="book-parts-label">Pars</span>
      </div>
      <hr class="book-divider">
      <ul class="book-parts-list">
        <% @catecismo_parts.each do |part| %>
          <li>
            <a class="book-part-link" href="<%= "/books/catecismo-pio-x/#{part}" %>">
              <%= part.sub('-', ' ').gsub('_', ' ') %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
