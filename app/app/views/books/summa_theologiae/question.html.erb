<!-- Modernized and mobile-friendly Summa Theologiae question page -->
<div class="summa-main-container">
  <aside class="summa-sidebar"></aside>
  <section class="summa-content">
    <h1 class="summa-title">Suma Teológica</h1>
    <span class="summa-subtitle">Summa Theologiae Quaestiones</span>
    <hr class="summa-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/summa-theologiae/#{@part}" %>" class="summa-back-link">&larr; Voltar</a>
      </div>
      <div class="summa-header-info">
        <h2>Questões</h2>
        <span class="summa-parts-label">Quaestiones</span>
      </div>
      <div class="part-container">
        <span class="summa-part-name"><%= @part.split("-").last.gsub("_", " ") %></span>
        <span class="summa-question-number">Q.<%= @question %> &rarr;</span>
      </div>
    </div>
    <div class="summa-question-content">
      <%= @content %>
    </div>
  </section>
  <aside class="summa-sidebar"></aside>
</div>
