<!-- Modernized and mobile-friendly Summa Theologiae question page -->
<% content_for :body_class, 'book-page' %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Suma Teológica</h1>
    <span class="book-subtitle">Summa Theologiae</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/summa-theologiae/#{@part}" %>" class="book-back-link">&larr;</a>
      </div>
      <div class="book-header-info">
        <h2>Questões</h2>
        <span class="book-parts-label">Quaestiones</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= @part.split("-").last.gsub("_", " ") %></span>
        <span class="book-chapter-number">Q.<%= @question %> <a href="<%=Integer(@question)+1%>">&rarr;</a></span>
      </div>
    </div>
    <div class="book-chapter-content">
      <%= @content %>
      
      <div class="book-next-chapter">
        <a href="<%= "/books/summa-theologiae/#{@part}/#{Integer(@question)+1}" %>">
          Próximo Capítulo &rarr;
        </a>
      </div>
    </div>
  </section>
  <aside class="book-sidebar"></aside>
</div>
