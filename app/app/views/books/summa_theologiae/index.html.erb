<% content_for :title, "Suma Teológica - Schola Theologiae" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <%= render "components/book_head", title: "Suma Teológica", subtitle: "Summa Theologiae" %>

    <hr class="book-divider">

    <%= render "components/book_info",
               cover: "summa_theologiae_st_thomas_aquinas.webp",
               alt: "São Tomás de Aquino escrevendo a Suma Teológica",
               description: "A Suma Teológica é uma obra escrita por São Tomás de Aquino entre 1265 e 1274. É considerada uma das mais importantes obras da teologia cristã e da filosofia ocidental." %>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Partes</h2>
        <span class="book-parts-label">Pars</span>
      </div>
      <hr class="book-divider">

      <% if @parts.blank? %>
        <%= render "components/content_state",
                   icon: "nf-md-cloud_off",
                   title: "Conteúdo indisponível",
                   message: "Não conseguimos carregar as partes da Suma Teológica agora. Tente novamente em instantes." %>
      <% else %>
        <ul class="book-parts-list">
          <% @parts.each do |part| %>
            <li>
              <a class="book-part-link" href="/books/summa-theologiae/<%= part %>">
                <%= part_name("summa_theologiae", part) %>
              </a>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
