<!-- Modernized and mobile-friendly Summa Theologiae index page -->
<div class="summa-main-container">
  <aside class="summa-sidebar"></aside>

  <section class="summa-content">
    <h1 class="summa-title">Suma Teológica</h1>
    <span class="summa-subtitle">Summa Theologiae</span>

    <hr class="summa-divider">

    <div class="summa-info">
      <%= image_tag("summa_theologiae_st_thomas_aquinas.jpg", class: "summa-cover", skip_pipeline: true) %>
      <p class="summa-description">
        A Suma Teológica é uma obra escrita por São Tomás de Aquino entre 1265 e 1274. É considerada uma das mais importantes obras da teologia cristã e da filosofia ocidental.
      </p>
    </div>

    <section class="summa-parts">
      <div class="summa-parts-header">
        <h2>Partes</h2>
        <span class="summa-parts-label">Pars</span>
      </div>
      <hr class="summa-divider">
      <ul class="summa-parts-list">
        <%# SORT part by number x.x  %>
        <% @summa_parts = @summa_parts.sort_by { |part| part.split('.').map(&:to_i) } %>
        <% @summa_parts.each do |part| %>
          <li>
            <a class="summa-part-link" href="<%= "/books/summa-theologiae/#{part}" %>">
              <%= part.sub('-', ' - ').gsub('_', ' ') %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  </section>

  <aside class="summa-sidebar"></aside>
</div>
