<!-- Modernized and mobile-friendly Summa Theologiae index page -->
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <div class="book-header">
      <div class="book-back-button">
        <a href="/books/" class="book-back-link">
          <i class="nf nf-md-arrow_left"></i>
        </a>
      </div>

      <div class="book-title-container">
        <h1 class="book-title">Suma Teológica</h1>
        <span class="book-subtitle">Summa Theologiae</span>
      </div>

      <div style="width: 10px;"></div>
    </div>

    <hr class="book-divider">

    <div class="book-info">
      <%= image_tag("summa_theologiae_st_thomas_aquinas.jpg", class: "book-cover", skip_pipeline: true) %>
      <p class="book-description">
        A Suma Teológica é uma obra escrita por São Tomás de Aquino entre 1265 e 1274. É considerada uma das mais importantes obras da teologia cristã e da filosofia ocidental.
      </p>
    </div>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Partes</h2>
        <span class="book-parts-label">Pars</span>
      </div>
      <hr class="book-divider">
      <ul class="book-parts-list">
        <%# SORT part by number x.x  %>
        <% @summa_parts = @summa_parts.sort_by { |part| part.split('.').map(&:to_i) } %>
        <% @summa_parts.each do |part| %>
          <li>
            <a class="book-part-link" href="<%= "/books/summa-theologiae/#{part}" %>">
              <%= part.sub('-', ' - ').gsub('_', ' ') %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
