<!-- Modernized and mobile-friendly Summa Theologiae questions list page -->
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Suma Teológica</h1>
    <span class="book-subtitle">Summa Theologiae</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="<%= "/books/summa-theologiae" %>" class="book-back-link">&larr; Voltar</a>
      </div>
      <div class="book-header-info">
        <h2>Questões</h2>
        <span class="book-parts-label">Quaestiones</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= @part.split("-").last.gsub("_", " ") %></span>
      </div>
    </div>
    <ul class="book-questions-list">
      <% @summa_questions.each do |question| %>
        <% question_num = question.split(':').first %>
        <% question_title = question.split(':').last.strip %>
        <li>
          <a class="book-part-link" href="<%= "/books/summa-theologiae/#{@part}/#{question_num}" %>">
            <%= question_num %>: <%= question_title %>
          </a>
        </li>
      <% end %>
    </ul>
  </section>
  <aside class="book-sidebar"></aside>
</div>
