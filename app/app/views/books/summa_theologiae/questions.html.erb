<% content_for :title, "Questões - Suma Teológica - Schola Theologiae" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>
  <section class="book-content">
    <h1 class="book-title">Suma Teológica</h1>
    <span class="book-subtitle">Summa Theologiae</span>
    <hr class="book-divider">
    <div class="questions-header">
      <div class="back-container">
        <a href="/books/summa-theologiae" class="book-back-link" aria-label="Voltar para as partes">
          <i class="nf nf-md-arrow_left" aria-hidden="true"></i>
        </a>
      </div>
      <div class="book-header-info">
        <h2>Questões</h2>
        <span class="book-parts-label">Quaestiones</span>
      </div>
      <div class="part-container">
        <span class="book-part-name"><%= part_name("summa_theologiae", @part) %></span>
      </div>
    </div>

    <% if @not_found %>
      <%= render "components/content_state",
                 icon: "nf-md-book_remove",
                 title: "Parte não encontrada",
                 message: "Não encontramos esta parte da Suma Teológica. Volte para a lista de partes." %>
    <% elsif @questions.blank? %>
      <%= render "components/content_state",
                 icon: "nf-md-book_off",
                 title: "Nenhuma questão publicada",
                 message: "Ainda não há questões disponíveis nesta parte." %>
    <% else %>
      <ul class="chapters-list">
        <% @questions.each do |question| %>
          <li>
            <a class="chapter-link" href="/books/summa-theologiae/<%= @part %>/<%= question[:number] %>">
              <span class="chapter-number"><%= question[:number] %></span>
              <span class="chapter-title"><%= question[:title] %></span>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <aside class="book-sidebar"></aside>
</div>
