<% content_for :title, "Confissões - Schola Theologiae" %>
<div class="book-main-container">
  <aside class="book-sidebar"></aside>

  <section class="book-content">
    <%= render "components/book_head", title: "Confissões", subtitle: "Santo Agostinho" %>

    <hr class="book-divider">

    <%= render "components/book_info",
               cover: "confissoes_cover.webp",
               alt: "Capa das Confissões de Santo Agostinho",
               description: "As Confissões de Santo Agostinho, obra-prima da literatura cristã e da autobiografia espiritual, retrata a jornada de conversão e a busca por Deus do grande Doutor da Igreja." %>

    <section class="book-parts">
      <div class="book-parts-header">
        <h2>Livros</h2>
        <span class="book-parts-label">Libri</span>
      </div>
      <hr class="book-divider">

      <% if @parts.nil? %>
        <%= render "components/content_state",
                   icon: "nf-md-cloud_off",
                   title: "Conteúdo indisponível",
                   message: "Não conseguimos carregar os livros das Confissões agora. Tente novamente em instantes." %>
      <% else %>
        <% @parts.each_with_index do |part, index| %>
          <%= render "components/chapter_section",
                     title: "Livro #{to_roman(index + 1)} - #{humanize_slug(part)}",
                     part: part,
                     chapters: @chapters[part],
                     book_path: "/books/confissoes" %>
        <% end %>
      <% end %>
    </section>
  </section>

  <aside class="book-sidebar"></aside>
</div>
