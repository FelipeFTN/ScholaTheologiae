<div id="didaque" class="book-card">
  <a href="/books/didaque">
    <h2>Didaqué</h2>
    <%= image_tag("didaque_cover.webp", class: "book-cover", alt: "Capa da Didaqué", skip_pipeline: true, loading: "lazy") %>
    <div class="book-description">
      O Didaqué, ou "Ensino dos Doze Apóstolos", é um antigo manual cristão que oferece orientações práticas sobre a fé, moral e vida comunitária dos primeiros cristãos.
    </div>
    <div class="book-action">
      <i class="nf nf-md-heart"></i>
      Ler Didaqué
    </div>
  </a>
</div>
